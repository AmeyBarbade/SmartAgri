# Copy to .env and fill in. Never commit .env.

# --- MySQL (docker-compose / mysql profile) ---
MYSQL_DATABASE=agrioptima
MYSQL_USER=agrioptima
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- Backend ---
# Base64-encoded secret, at least 256 bits (e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=720
ML_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- LLM (optional; a template explanation is used when unset) ---
LLM_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api
